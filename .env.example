# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=metro_atlanta_saves
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${POSTGRES_DB}?schema=public

# API Configuration
API_PORT=3000
FE_PORT=4200
# Comma-separated frontend origins accepted by Better Auth and CORS.
CORS_ORIGIN=http://localhost:4200
# Public HTTPS origin used in generated email links and for uploaded email assets.
# Set this to the site's origin for each environment. A local URL is not reachable by recipients.
PUBLIC_APP_URL=https://metroatlantasaves.com

# Where user uploads are written. Defaults to <cwd>/.uploads when unset; in
# production this is a Docker volume.
UPLOAD_DIR=

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000
# Optional hostnames accepted by Better Auth, e.g. metroatlantasaves.com.
BETTER_AUTH_ALLOWED_HOSTS=
# Leave both unset to disable Google sign-in and One Tap.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend Configuration (keep the key server-side; never commit a real key)
RESEND_API_KEY=
MAIL_FROM=no-reply@metroatlantasaves.com
# Generate a 32-byte-or-longer random value and use the same secret in production and staging.
EMAIL_UNSUBSCRIBE_SECRET=
# Production/staging links resolve to production; local development may use http://localhost:3000/api/users/unsubscribe.
EMAIL_UNSUBSCRIBE_URL=https://metroatlantasaves.com/api/users/unsubscribe
# Set only in staging to https://metroatlantasaves.com/api/users/campaign-suppressions.
EMAIL_PREFERENCE_SOURCE_URL=
# =========================
# Web Push (VAPID) Configuration
# =========================
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=https://metroatlantasaves.com
