# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=metro_atlanta_saves
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${POSTGRES_DB}?schema=public

# API Configuration
API_PORT=3000
FE_PORT=4200
# Comma-separated frontend origins accepted by Better Auth and CORS.
CORS_ORIGIN=http://localhost:4200
# Public HTTPS origin used when embedding uploaded rich-text images in email.
# A local URL will not be reachable by external email providers.
PUBLIC_APP_URL=https://brpatl.com

# Where user uploads are written. Defaults to <cwd>/.uploads when unset; in
# production this is a Docker volume.
UPLOAD_DIR=

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000
# Optional for sites served on multiple hostnames, e.g. brpatl.com,www.brpatl.com.
BETTER_AUTH_ALLOWED_HOSTS=
# Leave both unset to disable Google sign-in and One Tap.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_USER=your_mail_user
MAIL_PORT=587
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@example.com
# =========================
# Web Push (VAPID) Configuration
# =========================
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@yourdomain.com
