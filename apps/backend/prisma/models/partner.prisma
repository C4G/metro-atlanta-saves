model Partner {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  name      String
  address   String?
  twitter   String?
  facebook  String?
  linkedIn  String?
  tiktok    String?
  website   String?
  program   Program[]
  users     User[]

  @@map("partners")
}
