model DiscussionComment {
  id              String                  @id @default(uuid())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now())
  body            String
  upvotes         Int                     @default(0)
  downvotes       Int                     @default(0)
  post            DiscussionPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId          String
  author          User                    @relation(fields: [authorId], references: [id])
  authorId        String
  parentComment   DiscussionComment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  parentCommentId String?
  replies         DiscussionComment[]     @relation("CommentReplies")
  votes           DiscussionCommentVote[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentCommentId])
  @@map("discussionComments")
}
