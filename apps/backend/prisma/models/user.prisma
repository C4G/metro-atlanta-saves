model User {
  id                      String                  @id @default(uuid())
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @default(now())
  lastLogin               DateTime?
  firstName               String                  @default("")
  lastName                String                  @default("")
  email                   String                  @unique
  name                    String                  @default("")
  emailVerified           Boolean                 @default(false)
  image                   String?
  forgot                  String?
  hash                    String                  @default("")
  role                    Role?
  partner                 Partner?                @relation(fields: [partnerId], references: [id])
  partnerId               String?
  bio                     String?
  UsersOnPrograms         UsersOnPrograms[]
  enrollment              Enrollment[]
  Image                   Image[]
  alliesOnPrograms        AlliesOnPrograms[]
  discussionPosts         DiscussionPost[]
  discussionComments      DiscussionComment[]
  discussionBoardsCreated DiscussionBoard[]       @relation("DiscussionBoardCreatedBy")
  discussionBoardMembers  DiscussionBoardMember[] @relation("DiscussionBoardMembers")
  discussionCommentVotes  DiscussionCommentVote[]
  pushSubscriptions       PushSubscription[]
  sessions                Session[]
  accounts                Account[]

  @@map("users")
}
